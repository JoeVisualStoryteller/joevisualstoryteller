{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "repo-changes/**",
              "src/**",
              "src/components/**",
              "src/data/**",
              "src/hooks/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|JetBrains Mono|Inter))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, JetBrains Mono, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent-pearl",
      "--alert",
      "--bg",
      "--bg-band",
      "--bg-panel",
      "--border",
      "--border-strong",
      "--ceremony",
      "--crimson",
      "--crimson-30",
      "--cyan",
      "--cyan-04",
      "--cyan-25",
      "--danger",
      "--diamond",
      "--fg-1",
      "--fg-2",
      "--fg-3",
      "--fg-4",
      "--fg-5",
      "--fg-6",
      "--font-display",
      "--font-mono",
      "--font-sans",
      "--glow-gold-card",
      "--glow-gold-medium",
      "--glow-gold-soft",
      "--glow-maroon-soft",
      "--gold",
      "--gold-04",
      "--gold-12",
      "--gold-15",
      "--gold-20",
      "--gold-30",
      "--gold-40",
      "--gold-60",
      "--hairline",
      "--highlight",
      "--light-blue",
      "--maroon",
      "--maroon-12",
      "--maroon-30",
      "--maroon-60",
      "--parchment",
      "--raised",
      "--raised-2",
      "--rare",
      "--rule",
      "--signal",
      "--surface",
      "--track-mono",
      "--track-wide",
      "--track-wider",
      "--track-widest",
      "--void"
    ],
    "tokenKinds": {
