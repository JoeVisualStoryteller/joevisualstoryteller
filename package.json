    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "gh-pages": "^6.3.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
